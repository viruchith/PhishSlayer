# Copy to `.env` in the repository root (or export in your shell) before running the backend.
# The PoC runs without this key using a built-in mock scenario.
GEMINI_API_KEY=

# Optional: override the default fast model (default is gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.0-flash

# Optional: max output tokens for generation (default 8192; was 1024 and truncated JSON).
# GEMINI_MAX_OUTPUT_TOKENS=8192

PORT=8787
